{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shortcuts",
	"main": "controllers/redirect-worker.ts",
	"compatibility_date": "2026-07-16",
	"assets": { "directory": "./resources", "binding": "ASSETS" },
	"routes": [
		{ "pattern": "from.eccs.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	}
}
